# Copy to .env.local and fill in the Entra app registration.
# Generate a long random value. Required before Microsoft sign-in will turn on.
AUTH_SECRET=

# Public URL of this app. Must match the host you registered as a redirect URI.
AUTH_URL=http://localhost:4748

# Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_ID=

# Client secret value
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Directory (tenant) ID. Single-tenant sign-in.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Optional if you would rather paste the full issuer.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Mailbox for the all-day invite. Used only after a manager turns calendar invites on in the app.
ITOPS_EMAIL=itops@ttecdigital.com

# Set to 0 to keep the Components page read-only (no npm install from the app).
# TIMEOFF_COMPONENT_UPDATES=0

# Dates in the app are calculated in this timezone.
ORG_TIMEZONE=America/Chicago

# Windows timezone name used for the all-day Graph event. Central covers CST and CDT.
ORG_GRAPH_TIMEZONE=Central Standard Time

# Demo directory: leave unset to show it only when Entra is not configured and NODE_ENV is not production.
# DEMO_MODE=true
